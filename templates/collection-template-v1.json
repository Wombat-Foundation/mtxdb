{
  "format": "mtxdb.collection-template/v1",
  "name": "<template-name>",
  "version": 1,
  "input": { "decoder": "json", "framing": ["jsonl"] },
  "record": {
    "identity": {
      "extract": { "kind": "json-pointer-rfc-6901", "path": "/<record-id>" },
      "validate": { "kind": "scalar", "type": "string" },
      "internal_key": { "kind": "digest", "algorithm": "sha2-256", "input": "extracted-value" }
    },
    "payload": { "policy": "retain-source" }
  },
  "collection": {
    "kind": "<collection-kind>",
    "membership": {
      "extract": { "kind": "json-pointer-rfc-6901", "path": "/<collection-key>" },
      "validate": { "kind": "scalar", "type": "string" }
    },
    "internal_key": { "kind": "digest", "algorithm": "sha2-256", "input": "membership-value" },
    "labels": [{ "name": "display_id", "value": "membership-value" }]
  },
  "establishment": { "selector": "<establishment-selector>" },
  "metadata": [],
  "edges": [],
  "validation": { "on_missing_identity": "reject-record", "on_missing_membership": "reject-record" },
  "extensions": {}
}
