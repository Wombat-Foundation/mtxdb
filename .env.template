# export MTXDB_BENCH_ROOT=/path/to/scratch-on-a-real-disk

# Per-record zstd. Any value other than "0" leaves it on; "0" disables it.
export MTXDB_BENCH_COMPRESS=0

# Frame checksum posture for comparison benches:
#   full (default) | writeonly | disabled
# scripts/external_bench.py deliberately overrides this per posture.
export MTXDB_BENCH_CHECKSUM=writeonly

# Per-collection decoded-node cache entries for compare_external.
# Default 0 (off) so point-read sweeps measure misses; 100000 opts into the
# production default. NOTE: this is benchmark-only, not a runtime memory knob.
# export MTXDB_BENCH_CACHE_CAPACITY=0

# Opt-in sustained-write phase for compare_external: many small fully-durable
# batches back-to-back (long enough to push an LSM engine through several
# memtable flushes/compactions), reporting throughput plus p50/p95/p99 batch
# latency, then a reopen + sampled-key verify pass. Off by default.
# scripts/external_bench.py inherits this from the ambient environment (unlike
# MTXDB_BENCH_CHECKSUM, which it always overrides), so setting it here also
# adds the sustained phase to each of that script's per-engine invocations.
# export MTXDB_BENCH_SUSTAINED=1

# Target volume (MB) for the sustained-write phase above; default ~64 MB.
# export MTXDB_BENCH_SUSTAINED_MB=256


