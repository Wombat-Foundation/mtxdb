#!/usr/bin/env bash
# =============================================================================
# mtxdb environment template
# =============================================================================
#
# This is a sourceable bash fragment, not a dotenv parser. Copy it to a local,
# git-ignored `.env` and source that:
#
#   cp .env.template .env
#   $EDITOR .env
#   set -a; . ./.env; set +a
#
# (`.envrc`/direnv users can keep sourcing `.env`; this file is the reference.)
#
# Scope legend:
#   [runtime]  read by the library or the `mtxdb` CLI in normal use
#   [build]    read by Cargo, the Makefile, or the compiler/linker
#   [test]     child-process/crash-test plumbing; set only when a test asks
#   [bench]    read only by benches/ (not shipped, no runtime effect)
#   [example]  read only by examples/ (not shipped, no runtime effect)
#
# This list was audited against the current tree (2026-11-04) by searching every
# `MTXDB_*` read in `src/`, `mtxdb-cli/src/`, `benches/`, `tests/`, `examples/`,
# `scripts/`, `Makefile`, and CI. If you add an env read, add it here.
#
# Not read by this tree (do not rely on them): SYNAPSE_MTXDB_* belongs to the
# Synapse adapter, not mtxdb. Older design notes also mention
# MTXDB_CHECKPOINT_IDENTITIES, MTXDB_CHECKPOINT_INCLUDE_IDENTITIES,
# MTXDB_CHECKPOINT_VERIFY, MTXDB_INDEX_SLOTS_ONLY, MTXDB_SYNC, MTXDB_NO_SYNC,
# MTXDB_WAL, MTXDB_NAMESPACE, MTXDB_D, MTXDB_HOST_DIR, and
# MTXDB_FORCE_SYNC_EVENT_JSON; none of those are read by current code.
#
# =============================================================================


# =============================================================================
# MEMORY: knobs for mtxdb-owned allocations, but no total-RSS cap
# =============================================================================
#
# The CLI honours MTXDB_CACHE_CAPACITY, MTXDB_TXN_STAGE_LIMIT_BYTES,
# MTXDB_INDEX_RESIDENCY and MTXDB_STATS (see "Runtime: resource limits" below).
# Library embedders opt in by calling `RuntimeConfig::from_env()` and passing
# it to a `*_with_config` constructor; the library does not read the environment
# on its own. Explicit API arguments always win over environment values.
#
# There is deliberately no MTXDB_MEMORY_LIMIT / MTXDB_MAX_RSS /
# MTXDB_RAM_MB. mtxdb cannot enforce total RSS from inside the process.
#
# To enforce a hard 128 MB cap, use the kernel, not mtxdb:
#
#   # cgroup v2, transient scope (recommended on Linux/systemd)
#   systemd-run --user --scope -p MemoryMax=128M -p MemorySwapMax=0 -- <command>
#
#   # a service unit
#   [Service]
#   MemoryMax=128M
#   MemorySwapMax=0
#
#   # containers
#   docker run --memory=128m ...        # or podman --memory=128m
#
# cgroup v2's `memory.max` charges page cache as well as anonymous memory, so
# it is the only cap that actually bounds the whole process. Prefer it.
#
# Generic allocator knobs such as MALLOC_ARENA_MAX=2 (glibc) or
# MALLOC_TRIM_THRESHOLD_ can lower steady-state RSS, but they do not cap it.
#
# `ulimit -v 131072` (KiB) caps virtual address space, but mtxdb mmaps pack
# files and sidecars, so it can reject a process whose RSS is far below 128 MB.
# `ulimit -m` is ignored by Linux. Neither is a good primary control.
#
# What actually consumes memory inside mtxdb:
#
#   * Resident index: ~16 bytes per record (capacity 2N x 8-byte slot), all
#     resident. 128 MiB is therefore roughly an 8M-record index floor before
#     any other allocation. See docs/DESIGN-open-and-index-persistence.md.
#   * Decoded-node cache: 100,000 entries *per collection* by default. It grows
#     lazily, but a store with many active collections can accumulate a lot.
#     `MTXDB_CACHE_CAPACITY` sets it (0 disables); the CLI passes it through
#     `Database::open_with_config`. The explicit library API remains available:
#         PackfileStorage::open_with_cache(dir, 0)
#         PackfileStorage::open_with_cache_and_policies(dir, cap, compress, checksum)
#   * Index residency: `IndexResidency::Paged` keeps sealed-pack locators in
#     their mmap'd sidecars instead of the resident table, which cuts heap
#     sharply. `MTXDB_INDEX_RESIDENCY=paged` applies only to genuinely
#     standalone `PackfileStorage` opens. Writable pools inside a database root
#     are rejected before any I/O, and `Database`/shared-WAL also rejects it
#     *before* taking the root lock or opening the WAL, because paged sync
#     cannot advance durable journal coverage yet.
#   * Transaction stage: 64 MiB engine ceiling
#     (`MAX_TXN_STAGE_BYTES`). `MTXDB_TXN_STAGE_LIMIT_BYTES` may lower it;
#     values above 64 MiB or zero are rejected.
#   * Mapped pack files and page cache: not heap, but charged to a cgroup.
#
# Practical result: a 128 MB cgroup is realistic for small stores and/or Paged
# standalone opens. It is not a safe default for a large Resident/`Database`
# deployment; there the index floor alone dominates.


# =============================================================================
# Shell / build / toolchain
# =============================================================================

export RUST_BACKTRACE=1                  # 0/1/full; runtime panic backtraces

# Native-CPU codegen is host-only. Exporting it here applies to every target
# too, breaking cross builds such as `--target wasm32-wasip1` ("target-cpu
# native" is not a valid wasm CPU). Prefer the host-gated
# .cargo/cargo-wrapper.sh instead of setting it globally.
# export RUSTFLAGS="-C target-cpu=native"

# Read by the `cc` crate (used to build zstd-sys's C sources / probe a
# system compiler) as the C compiler to invoke, overriding the system
# default (`/usr/bin/cc`). Also honored, more specifically, as
# `CC_<target-triple>`/`TARGET_CC` for cross builds.
# export CC=/usr/bin/gcc

# Runtime shared-library search path. Only needed if a prebuilt libzstd
# (see ZSTD_LIB_DIR below) lives somewhere the dynamic linker doesn't
# already search by default, e.g. /usr/local/lib on some distros. Affects
# every dynamically-linked binary run from this shell, not just mtxdb's.
# export LD_LIBRARY_PATH=/usr/local/lib

# Read by zstd-sys's own build script (not mtxdb's code) to link a prebuilt
# libzstd instead of building the vendored C sources from scratch. Pair with
# LD_LIBRARY_PATH above when the prebuilt lib lives outside the default
# search path.
# export ZSTD_LIB_DIR=/usr/local/lib

# Cargo binary used by the Makefile. Default: cargo.
# export CARGO="cargo +1.88.0"

# Bench crate toolchain (benches/ needs newer than the library MSRV).
# Makefile default: 1.90.0.
# export BENCH_TOOLCHAIN=1.90.0

# Cargo profile used by `make install` (dev = faster builds, unoptimized binary).
# Makefile default: release.
export MTXDB_INSTALL_PROFILE=dev

# Cargo profile used by `make test` / `make cov`. Makefile default: test.
# export MTXDB_TEST_PROFILE=dev-quick

# Derived by the Makefile from MTXDB_TEST_PROFILE; do not set it directly.
# export MTXDB_TEST_PROFILE_FLAG="--profile dev-quick"

# Extra flags for `make cov`'s llvm-cov report step. Not mtxdb-specific.
# export LLVM_COV_FLAGS="-show-region-summary=false -show-branch-summary=false"


