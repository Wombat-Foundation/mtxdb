# Default database root for `mtxdb -d/--dir`. Resolution order is explicit -d,
# then a database root in the current directory, then MTXDB_DIR.
# Set this in a local, git-ignored .env when a non-default location is needed.
export MTXDB_DIR="$HOME/.mtxdb-test"

# Default pool for CLI commands: state | event/events/event-dag | edges |
# server-info | all. CLI default: events.
# export MTXDB_SHARD_TYPE=all

# How many event ids each `mtxdb import` warning names. An integer, or "all".
# Default: 10.
# export MTXDB_IMPORT_WARNING_LIMIT=10


# =============================================================================
# Runtime: resource limits and diagnostics
# =============================================================================

# Decoded-node cache entries, applied independently to each collection.
# 0 disables the cache. Default: 100000. This is the main mtxdb-owned heap
# lever; it is not a total-RSS cap. `MTXDB_BENCH_CACHE_CAPACITY` only affects
# the compare_external benchmark.
# export MTXDB_CACHE_CAPACITY=100000

# Maximum charged payload one transaction may stage, in bytes. Lower-only;
# must be in 1..=67108864 (64 MiB). Invalid values are a hard startup error.
# Default: 67108864.
# export MTXDB_TXN_STAGE_LIMIT_BYTES=67108864

# Where sealed-pack locators live:
#   resident (default) - every pack in the resident index
#   paged              - sealed packs use mmap'd sidecars
# `paged` is accepted only for genuinely standalone pools. Database/shared-WAL
# commands reject it because journaling cannot advance paged coverage yet, and
# writable pools inside a database root reject it before any I/O so a
# maintenance command cannot convert the root's representation.
# export MTXDB_INDEX_RESIDENCY=resident

# Enable the opt-in read-path counters and latency accounting.
# Accepts 1/0, true/false, on/off, yes/no. Default: off.
# export MTXDB_STATS=1


# =============================================================================
# Runtime: storage/checkpoint integrity
# =============================================================================

# Checkpoint-open verification posture.
#   full      (default) verify checkpoint bytes on open
#   writeonly skip read-side verification; write-side checksums still emitted
# This does not affect frame or delta-log checksums.
# export MTXDB_CHECKPOINT_CHECKSUM=writeonly

# Opt-in Linux writeback hint (src/engine/shard.rs): sync_file_range(2) after
# each flush. ~36% off SSD ingest wall in the fast mode, ~1% on HDD; errors are
# swallowed and it is a no-op on tmpfs. Enabled by any value other than "0"
# (including an empty value); currently enabled in this template.
# See docs/TODO.txt.
export MTXDB_SYNC_FILE_RANGE=1


