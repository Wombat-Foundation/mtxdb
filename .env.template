# =============================================================================
# Benchmarks: io_append
# =============================================================================
#
# Append-path A/B: eager vs buffered pack writes, per-record vs put_many WAL
# publication. MTXDB_PREALLOC (runtime section) also A/Bs block reservation.
# export MTXDB_IO_RECORDS=100000
# export MTXDB_IO_PAYLOAD=256
# export MTXDB_IO_BATCH=1000        # records per put_many / WAL group
# export MTXDB_IO_JOURNAL=0         # omit the shared WAL to isolate pack appends


# =============================================================================
# Benchmarks: seal_rotation
# =============================================================================
#
# Sidecar-build backlog vs writer latency. Set MTXDB_BENCH_ROOT to a real disk.
# MTXDB_SEAL_DELAY_MS=0 runs real builds; a positive value injects a fixed
# per-build delay instead (test-util only).
# export MTXDB_SEAL_PACK_MIB=8      # rotation threshold per pack
