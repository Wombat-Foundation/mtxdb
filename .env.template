#!/usr/bin/env bash

# Native-CPU codegen is host-only. Exporting it here applies to every target
# too, breaking cross builds such as `--target wasm32-wasip1` ("target-cpu
# native" is not a valid wasm CPU). Prefer the host-gated
# .cargo/cargo-wrapper.sh instead of setting it globally.
# export RUSTFLAGS="-C target-cpu=native"
export RUST_BACKTRACE=1

# Read by the `cc` crate (used to build zstd-sys's C sources / probe a
# system compiler) as the C compiler to invoke, overriding the system
# default (`/usr/bin/cc`). Also honored, more specifically, as
# `CC_<target-triple>`/`TARGET_CC` for cross builds.
# export CC=/usr/bin/gcc

# Runtime shared-library search path. Only needed if a prebuilt libzstd
# (see ZSTD_LIB_DIR below) lives somewhere the dynamic linker doesn't
# already search by default, e.g. /usr/local/lib on some distros. Affects
# every dynamically-linked binary run from this shell, not just mtxdb's.
# export LD_LIBRARY_PATH=/usr/local/lib

# Read by zstd-sys's own build script (not mtxdb's code) to link a prebuilt
# libzstd instead of building the vendored C sources from scratch. Pair with
# LD_LIBRARY_PATH above when the prebuilt lib lives outside the default
# search path.
# export ZSTD_LIB_DIR=/usr/local/lib

# Set this in a local, git-ignored .env when a non-default location is needed.
export MTXDB_DIR="$HOME/.mtxdb-test"

# Keep the safe default (`full`) unless deliberately trading checkpoint-open
# integrity verification for lower startup latency. This does not affect frame
# or delta-log checksums.
# export MTXDB_CHECKPOINT_CHECKSUM=writeonly

# For direct `cargo bench --bench compare_external` runs, this selects the
# mtxdb checksum posture. scripts/external_bench.py deliberately replaces it
# with its own three-posture sweep.
# export MTXDB_BENCH_CHECKSUM=disabled

# Opt-in sustained-write phase for `cargo bench --bench compare_external`:
# many small fully-durable batches back-to-back (long enough to push an LSM
# engine through several memtable flushes/compactions), reporting
# throughput plus p50/p95/p99 batch latency, then a reopen + sampled-key
# verify pass. Off by default. Note: scripts/external_bench.py inherits this
# from the ambient environment (unlike MTXDB_BENCH_CHECKSUM, which it always
# overrides), so setting it here also adds the sustained phase to each of
# that script's six per-engine invocations.
# export MTXDB_BENCH_SUSTAINED=1

export MTXDB_BENCH_COMPRESS=0
export MTXDB_BENCH_CHECKSUM=writeonly  # disabled

# Target volume (MB) for the sustained-write phase above; default ~64MB.
# export MTXDB_BENCH_SUSTAINED_MB=256

# Comma-separated GB targets for `cargo bench --bench compare_external`'s
# large-database curve (e.g. "1,10,100"). Runs one size per invocation --
# scripts/external_bench.py enforces that. Defaults to a single small
# (~0.1 GB) run when unset.
# export MTXDB_BENCH_EXT_GB=1,10

# Cargo profile used by `make install` (dev = faster builds, unoptimized binary).
export MTXDB_INSTALL_PROFILE=dev
#export MTXDB_TEST_PROFILE=dev

# `cargo bench --bench read_plan` only. Pauses between reads so the page
# cache can be dropped by hand (as root):
#   sudo sh -c 'echo 3 > /proc/sys/vm/drop_caches'
# Without this, read_plan falls back to `vmtouch -e`, which only evicts clean
# pages of the named files and can leave the read warm.
export MTXDB_READ_PLAN_MANUAL_DROP=1
