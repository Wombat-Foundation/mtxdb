#!/usr/bin/env bash
# =============================================================================
# mtxdb environment template
# =============================================================================
#
# This is a sourceable bash fragment, not a dotenv parser. Copy it to a local,
# git-ignored `.env` and source that:
#
#   cp .env.template .env
#   $EDITOR .env
#   set -a; . ./.env; set +a
#
# (`.envrc`/direnv users can keep sourcing `.env`; this file is the reference.)
#
# Scope legend:
#   [runtime]  read by the library or the `mtxdb` CLI in normal use
#   [build]    read by Cargo, the Makefile, or the compiler/linker
#   [test]     child-process/crash-test plumbing; set only when a test asks
#   [bench]    read only by benches/ (not shipped, no runtime effect)
#   [example]  read only by examples/ (not shipped, no runtime effect)
#
# This list was audited against the current tree (2026-11-12) by searching every
# `MTXDB_*` read in `src/`, `mtxdb-cli/src/`, `benches/`, `tests/`, `examples/`,
# `scripts/`, `Makefile`, and CI. If you add an env read, add it here.
# (2026-11-26: added CACHE_BYTES, POINT_RANDOM_MMAP, COMPRESS, IMPORT_TIMINGS
# ORDERED_INDEX_POINT_RANDOM_MMAP, and the timeline_multi_room knobs. That was
# not a full re-audit; some test, Makefile and benchmark variables are still
# undocumented here.)
#
# Not read by this tree (do not rely on them): SYNAPSE_MTXDB_* belongs to the
# Synapse adapter, not mtxdb. Older design notes also mention
# MTXDB_CHECKPOINT_IDENTITIES, MTXDB_CHECKPOINT_INCLUDE_IDENTITIES,
# MTXDB_CHECKPOINT_VERIFY, MTXDB_INDEX_SLOTS_ONLY, MTXDB_SYNC, MTXDB_NO_SYNC,
# MTXDB_WAL, MTXDB_NAMESPACE, MTXDB_D, MTXDB_HOST_DIR, and
# MTXDB_FORCE_SYNC_EVENT_JSON; none of those are read by current code.
# The MTXDB_EL_* edge-layout knobs belong to a retired benchmark and are also
# no longer read.
#
# =============================================================================


# =============================================================================
# MEMORY: knobs for mtxdb-owned allocations, but no total-RSS cap
# =============================================================================
#
# The CLI reads MTXDB_CACHE_BYTES, MTXDB_CACHE_CAPACITY,
# MTXDB_TXN_STAGE_LIMIT_BYTES, MTXDB_INDEX_RESIDENCY, MTXDB_STATS,
# MTXDB_POINT_RANDOM_MMAP, MTXDB_ORDERED_INDEX_POINT_RANDOM_MMAP,
# MTXDB_RECLAIM_TRIGGER_BYTES and
# MTXDB_REPLAY_LEASE_MAX_RETAINED_BYTES at startup (see the "Runtime:" sections
# below). Library embedders opt in to these by calling
# `RuntimeConfig::from_env()` and passing it to a `*_with_config` constructor;
# `Database::open` and `open_with_policies` ignore them. Explicit API arguments
# win over environment values. Exceptions that the library reads directly:
# MTXDB_SYNC_FILE_RANGE, MTXDB_PREALLOC and MTXDB_CHECKPOINT_CHECKSUM.
#
# There is deliberately no MTXDB_MEMORY_LIMIT / MTXDB_MAX_RSS /
# MTXDB_RAM_MB. mtxdb cannot enforce total RSS from inside the process.
#
# To enforce a hard 128 MB cap, use the kernel, not mtxdb:
#
#   # cgroup v2, transient scope (recommended on Linux/systemd)
#   systemd-run --user --scope -p MemoryMax=128M -p MemorySwapMax=0 -- <command>
#
#   # a service unit
#   [Service]
#   MemoryMax=128M
#   MemorySwapMax=0
#
#   # containers
#   docker run --memory=128m ...        # or podman --memory=128m
#
# cgroup v2's `memory.max` charges page cache as well as anonymous memory, so
# it is the only cap that actually bounds the whole process. Prefer it.
#
# Generic allocator knobs such as MALLOC_ARENA_MAX=2 (glibc) or
# MALLOC_TRIM_THRESHOLD_ can lower steady-state RSS, but they do not cap it.
#
# `ulimit -v 131072` (KiB) caps virtual address space, but mtxdb mmaps pack
# files and sidecars, so it can reject a process whose RSS is far below 128 MB.
# `ulimit -m` is ignored by Linux. Neither is a good primary control.
#
# What actually consumes memory inside mtxdb:
#
#   * Resident index: ~16 bytes per record (capacity 2N x 8-byte slot), all
#     resident. 128 MiB is therefore roughly an 8M-record index floor before
#     any other allocation. See docs/DESIGN-open-and-index-persistence.md.
#   * Decoded-node cache: 100,000 entries *per collection* by default. It grows
#     lazily, but a store with many active collections can accumulate a lot.
#     `MTXDB_CACHE_CAPACITY` sets it (0 disables); the CLI passes it through
#     `Database::open_with_config`. The explicit library API remains available:
#         PackfileStorage::open_with_cache(dir, 0)
#         PackfileStorage::open_with_cache_and_policies(dir, cap, compress, checksum)
#   * Index residency: `IndexResidency::Paged` keeps sealed-pack locators in
#     their mmap'd sidecars instead of the resident table, which cuts heap
#     sharply. `MTXDB_INDEX_RESIDENCY=paged` is read only by the `mtxdb` CLI
#     and by embedders that call `RuntimeConfig::from_env()` and pass the
#     result to a `*_with_config` constructor. `Database::open` and
#     `open_with_policies` ignore it, and an explicit per-pool policy wins over
#     the environment. Paged is still opt-in, not the default.
#   * Transaction stage: 64 MiB engine ceiling
#     (`MAX_TXN_STAGE_BYTES`). `MTXDB_TXN_STAGE_LIMIT_BYTES` may lower it;
#     values above 64 MiB or zero are rejected.
#   * Mapped pack files and page cache: not heap, but charged to a cgroup.
#
# Practical result: a 128 MB cgroup is realistic for small stores and/or Paged
# standalone opens. It is not a safe default for a large Resident/`Database`
# deployment; there the index floor alone dominates.


# =============================================================================
# LOGGING: mtxdb's tracing logger (opt-in)
# =============================================================================
#
# Enable the library logger with `cargo build -p mtxdb --features logging`, or
# the CLI logger with `cargo build -p mtxdb-cli --features logging`. Use
# `mtxdb::logging::info!` and related macros for structured events.
# The CLI installs mtxdb's stderr subscriber automatically; embedders can call
# `mtxdb::logging::init()` or install their own tracing subscriber. The default
# level is info; `RUST_LOG` accepts standard tracing-subscriber directives.
#
# export RUST_LOG=info                    # e.g. info, mtxdb=debug, off


# =============================================================================
# Shell / build / toolchain
# =============================================================================

export RUST_BACKTRACE=1                  # 0/1/full; runtime panic backtraces

# Native-CPU codegen is host-only. Exporting it here applies to every target
# too, breaking cross builds such as `--target wasm32-wasip1` ("target-cpu
# native" is not a valid wasm CPU). Prefer the host-gated
# .cargo/cargo-wrapper.sh instead of setting it globally.
# export RUSTFLAGS="-C target-cpu=native"

# Read by the `cc` crate (used to build zstd-sys's C sources / probe a
# system compiler) as the C compiler to invoke, overriding the system
# default (`/usr/bin/cc`). Also honored, more specifically, as
# `CC_<target-triple>`/`TARGET_CC` for cross builds.
# export CC=/usr/bin/gcc

# Runtime shared-library search path. Only needed if a prebuilt libzstd
# (see ZSTD_LIB_DIR below) lives somewhere the dynamic linker doesn't
# already search by default, e.g. /usr/local/lib on some distros. Affects
# every dynamically-linked binary run from this shell, not just mtxdb's.
# export LD_LIBRARY_PATH=/usr/local/lib

# Read by zstd-sys's own build script (not mtxdb's code) to link a prebuilt
# libzstd instead of building the vendored C sources from scratch. Pair with
# LD_LIBRARY_PATH above when the prebuilt lib lives outside the default
# search path.
# export ZSTD_LIB_DIR=/usr/local/lib

# Cargo binary used by the Makefile. Default: cargo.
# export CARGO="cargo +1.88.0"

# Bench crate toolchain (benches/ needs newer than the library MSRV).
# Makefile default: 1.90.0.
# export BENCH_TOOLCHAIN=1.90.0

# Cargo profile used by `make install` (dev = faster builds, unoptimized binary).
# Makefile default: release.
export MTXDB_INSTALL_PROFILE=dev

# Cargo profile used by `make test` / `make cov`. Makefile default: test.
# export MTXDB_TEST_PROFILE=dev-quick

# Derived by the Makefile from MTXDB_TEST_PROFILE; do not set it directly.
# export MTXDB_TEST_PROFILE_FLAG="--profile dev-quick"

# Extra flags for `make cov`'s llvm-cov report step. Not mtxdb-specific.
# export LLVM_COV_FLAGS="-show-region-summary=false -show-branch-summary=false"


# =============================================================================
# Runtime: mtxdb CLI
# =============================================================================

# Default database root for `mtxdb -d/--dir`. Resolution order is explicit -d,
# then a database root in the current directory, then MTXDB_DIR.
# Set this in a local, git-ignored .env when a non-default location is needed.
export MTXDB_DIR="$HOME/.mtxdb-test"

# Default pool for CLI commands: state | event/events/event-dag | edges |
# server-info | all. CLI default: events.
# export MTXDB_SHARD_TYPE=all

# How many event ids each `mtxdb import` warning names. An integer, or "all".
# Default: 10.
# export MTXDB_IMPORT_WARNING_LIMIT=10

# Override compression for the CLI's writable opens, in every pool.
# Accepts 1/0, true/false, yes/no, on/off. Unset keeps each pool's policy.
# export MTXDB_COMPRESS=0

# Print import phase timings. Enabled by ANY value, even 0; unset to disable.
# export MTXDB_IMPORT_TIMINGS=1

# Experimental raw-JSONL import fast path. Unset (default) keeps the whole-room
# walk. Any value enables the run-scoped waiting set and the direct clean-append
# path; it falls back per file when it cannot prove equivalence.
# export MTXDB_DIRECT_IMPORT=1

# Diagnostic for the direct import path. Only meaningful with
# MTXDB_DIRECT_IMPORT enabled. Emission order per file:
#
#   import: <path> took <t>
#       Per-file total, including the whole-room fallback when it runs.
#   direct: closure took <t> for N id(s)
#       Reverse-edge dirty closure. The first call in a run also builds the
#       reverse maps from the CSR snapshot; later calls only traverse.
#   direct: observe waiting <t>, adjacency <t>
#       Fold the written file into the run-scoped waiting and reverse-edge
#       caches. This is an incremental update, not the closure: a large
#       adjacency time here means cache maintenance, not dirty-set growth.
#   direct: loaded N dirty body(ies) in <t>
#   direct: built a N-event universe in <t>
#   direct: findings took <t>
#   direct: walk took <t> for N judged id(s)
#   direct: publish took <t>
#   direct: write took <t>, total <t>
#   direct: |F|=<n>, |D|=<n>, waited prev=<n> auth=<n>, |mapped|=<n>,
#           seeds=<n>, unchecked=<n>, gapped=<n>, unmapped=<n>
#   direct: fallback, <reason>
#   direct: N prev id(s) have no stored state group to seed
#
# |F| is the file's own events, |D| the stored events it re-judges, and
# |mapped| the state-group mappings this file published.
# export MTXDB_DIRECT_DEBUG=1


# =============================================================================
# Runtime: resource limits and diagnostics
# =============================================================================

# Byte budget for decoded node payloads, shared by every collection and pool of
# one database. A plain integer (no K/M suffix); 0 disables caching.
# Default: 16777216 (16 MiB). No valid comparison of other sizes exists yet.
# export MTXDB_CACHE_BYTES=16777216

# Decoded-node cache entries, applied independently to each collection.
# 0 disables the cache. Default: 100000. This is the main mtxdb-owned heap
# lever; it is not a total-RSS cap. `MTXDB_BENCH_CACHE_CAPACITY` only affects
# the compare_external benchmark.
# export MTXDB_CACHE_CAPACITY=100000

# Maximum charged payload one transaction may stage, in bytes. Lower-only;
# must be in 1..=67108864 (64 MiB). Invalid values are a hard startup error.
# Default: 67108864.
# export MTXDB_TXN_STAGE_LIMIT_BYTES=67108864

# Where sealed-pack locators live:
#   resident (default) - every pack in the resident index
#   paged              - sealed packs use mmap'd sidecars
# Read only by the `mtxdb` CLI and by embedders that call
# `RuntimeConfig::from_env()` and pass it to a `*_with_config` constructor.
# `Database::open` / `open_with_policies` ignore it, so an embedder such as
# sithnapse keeps resident residency unless it opts in explicitly.
# Paged residency is opt-in. With a shared WAL, open read-only workers using
# the same residency as the writer; the default shared reader uses resident
# indexes, so paged writers require the configured shared-reader constructor.
# Writable pools persist their mode in index.residency; shared readers fail
# closed if the record is missing, invalid, or doesn't match their mode.
# export MTXDB_INDEX_RESIDENCY=resident

# Enable the opt-in read-path counters and latency accounting.
# Accepts 1/0, true/false, on/off, yes/no. Default: off.
# export MTXDB_STATS=1

# Segment length, in bytes, above which a sync forces a reclaiming checkpoint.
# Default: the journal's built-in RECLAIM_TRIGGER_LEN (one quarter of the
# 256 MiB segment cap, about 64 MiB). Must be positive and below the
# emergency-zone boundary (three quarters of the live segment cap).
# export MTXDB_RECLAIM_TRIGGER_BYTES=67108864

# Cap, in bytes, on the WAL history one replay lease may retain. Unset means
# unlimited. On the next reclaim, a lease pinning more than this is revoked and
# reads through its cursor fail closed.
# export MTXDB_REPLAY_LEASE_MAX_RETAINED_BYTES=67108864


# =============================================================================
# Runtime: point-read mapping (experimental, HDD vs SSD)
# =============================================================================

# Serve `get` and one-ID `get_many` from a second pack mapping advised
# MADV_RANDOM. Larger batches and scans keep the normal mapping.
# Accepts 1/0, true/false, on/off, yes/no. Default: off.
#
#   HDD: leave OFF at its current 8,192 KiB readahead. Cold timeline pages
#        were 23-81x faster, but 256 event bodies read one `get` at a time
#        were 2.2x SLOWER in the two sweep runs (2.29x and 2.25x). At
#        128 KiB readahead the two HDD runs disagreed, so it is not proven
#        better either. See the tuning guide for the full sweep.
#   SSD: may be worth trying. Cold timeline pages were 2.3-4.1x faster and the
#        `get` loop 2.8-3.5x faster, in both runs.
#
# Those figures are at each drive's usual readahead (HDD 8192 KiB, SSD 128).
# Readahead explains most of the large page ratios: with the HDD at 128 KiB the
# page gain was only 1.3-2.4x, and its two `get` loop runs disagreed. Not
# measured: records adjacent on disk, warm reads, other record sizes.
#
# Scope: the variable applies to every pool opened with the runtime config
# (only event-DAG reads were measured), including event bodies and
# single-record transaction reads. It needs a program that calls
# RuntimeConfig::from_env(), such as the CLI; Synapse's adapter does not, so
# this has no effect there. Replacing a handle's read-plan policy afterwards
# overrides it (the CLI keeps it across --read-plan). In Rust, per handle:
#     db.event_dag().set_point_random_mmap(true);
# Details: docs/docs/2026-11-26-tuning-hdd-ssd.md
# export MTXDB_POINT_RANDOM_MMAP=1
# For ordered-index records only, keeping event bodies on the normal mapping.
# Accepts 1/0, true/false, on/off, yes/no. Default: off.
# export MTXDB_ORDERED_INDEX_POINT_RANDOM_MMAP=1


# =============================================================================
# Runtime: storage/checkpoint integrity
# =============================================================================

# Checkpoint-open verification posture.
#   full      (default) verify checkpoint bytes on open
#   writeonly skip read-side verification; write-side checksums still emitted
# This does not affect frame or delta-log checksums.
# export MTXDB_CHECKPOINT_CHECKSUM=writeonly

# Opt-in Linux writeback hint (src/engine/shard.rs): sync_file_range(2) after
# each flush. ~36% off SSD ingest wall in the fast mode, ~1% on HDD; errors are
# swallowed and it is a no-op on tmpfs. Enabled by any value other than "0"
# (including an empty value); currently enabled in this template.
# See docs/TODO.txt.
export MTXDB_SYNC_FILE_RANGE=1

# Best-effort Linux block reservation for pack appends (src/engine/io.rs):
# fallocate(FALLOC_FL_KEEP_SIZE) in 1 MiB chunks. It never changes the file's
# logical length, so it has no durability or recovery effect. Off by default;
# set MTXDB_PREALLOC=1 to opt in.
#
# A/B on ext4/LUKS with concurrent pools and real sidecar builds (2026-11-12)
# found reservation was a net loss there: disabling it raised writer
# throughput 1.2-5.5x and removed 0.9-1.5 s writer stalls, while the
# single-writer append bench was neutral. Leave it unset unless measurement
# shows a benefit on your disk.
# export MTXDB_PREALLOC=1


# =============================================================================
# Test-only crash / child-process plumbing
# =============================================================================
#
# These are compiled only into test builds (`#[cfg(test)]`) or used by
# integration-test children. They are listed for completeness; do not set them
# in a normal runtime environment.
#
# MTXDB_CRASH_AT=<point>       exit(70) at a named crash point (packfile/graph)
# MTXDB_CRASH_SCENARIO=<name>  child scenario for graph closure-store tests
# MTXDB_CRASH_ROOT=<dir>       root for that child
# MTXDB_VERSIONS_CRASH_DIR=<dir> versions-file crash test root
# MTXDB_SHARED_READER_ROOT=<dir>          reader child for shared-WAL tests
# MTXDB_SHARED_STALE_READER_ROOT=<dir>    stale-reader child
# MTXDB_SHARED_TRANSACTION_READER_ROOT=<dir> transactional-reader child
# MTXDB_SHARED_WAL_LOCK_CHILD_ROOT=<dir> child half of the cross-process
#                                        shared-WAL root-lock test
#
# export MTXDB_CRASH_AT=after-versions-fsync

# Not MTXDB_*, but test scratch depends on it: the mdb_test_* directories come
# from std::env::temp_dir(), which honours TMPDIR. On a host where /tmp is a
# small tmpfs, thousands of leftover run directories can exhaust it (this
# happened: 15k+ dirs hit the quota). Point TMPDIR at a real disk instead.
# export TMPDIR="/path/to/scratch-on-a-real-disk"


# =============================================================================
# Benchmarks: shared knobs
# =============================================================================
#
# Every variable in the Benchmarks sections below is read only by benches/ (a
# separate, opt-in crate). None of it changes library or CLI behavior.

# Scratch root for benchmark data. Unset -> std::env::temp_dir().
# Point this at a real disk (not tmpfs) for cold-cache/HDD/SSD measurements.
# export MTXDB_BENCH_ROOT=/path/to/scratch-on-a-real-disk

# Per-record zstd. Any value other than "0" leaves it on; "0" disables it.
export MTXDB_BENCH_COMPRESS=0

# Frame checksum posture for comparison benches:
#   full (default) | writeonly | disabled
# scripts/external_bench.py deliberately overrides this per posture.
export MTXDB_BENCH_CHECKSUM=writeonly

# Per-collection decoded-node cache entries for compare_external.
# Default 0 (off) so point-read sweeps measure misses; 100000 opts into the
# production default. NOTE: this is benchmark-only, not a runtime memory knob.
# export MTXDB_BENCH_CACHE_CAPACITY=0

# Opt-in sustained-write phase for compare_external: many small fully-durable
# batches back-to-back (long enough to push an LSM engine through several
# memtable flushes/compactions), reporting throughput plus p50/p95/p99 batch
# latency, then a reopen + sampled-key verify pass. Off by default.
# scripts/external_bench.py inherits this from the ambient environment (unlike
# MTXDB_BENCH_CHECKSUM, which it always overrides), so setting it here also
# adds the sustained phase to each of that script's per-engine invocations.
# export MTXDB_BENCH_SUSTAINED=1

# Target volume (MB) for the sustained-write phase above; default ~64 MB.
# export MTXDB_BENCH_SUSTAINED_MB=256


# =============================================================================
# Benchmarks: timeline_multi_room
# =============================================================================
#
# Takes the runtime variables (such as MTXDB_CACHE_BYTES) for its database
# opens ONLY when MTXDB_CACHE_CAPACITY is also set. Its standalone paged-reader
# rows use defaults. It always ignores MTXDB_POINT_RANDOM_MMAP.
#
# export MTXDB_MULTI_EVENTS=1000000     # total events
# export MTXDB_MULTI_ROOMS=1000
# export MTXDB_MULTI_BATCH=64
# export MTXDB_PAYLOAD_MIN=256          # bytes; set MIN and MAX equal to fix size
# export MTXDB_PAYLOAD_MAX=4096
# export MTXDB_MAX_SHARD_BYTES=8388608  # event pool pack rotation size
# export MTXDB_TIMELINE_SAMPLES=10      # cold repetitions
# export MTXDB_MULTI_PAGE_ONLY=1        # presence enables
# export MTXDB_MULTI_OPEN_ONLY=1        # presence enables
#
# Mapping-advice A/B. Presence enables these three, even with an empty value:
# export MTXDB_PAGE_ADVICE_AB=1         # default/random/point, plus the get loop
# export MTXDB_PAGE_AB_REVERSE=1        # reverse modes (not the get loop)
# export MTXDB_PAGE_POINT_MAPPING=1     # point only, when AB is unset
# Enabled by any value except 0, when the two above that select modes are unset:
# export MTXDB_PAGE_RANDOM_ADVICE=1     # shared-mapping random advice only


