#!/usr/bin/env bash
export RUST_BACKTRACE=1
# Set this in a local, git-ignored .env when a non-default location is needed.
export MTXDB_DIR="$HOME/.mtxdb"
# Keep the safe default (`full`) unless deliberately trading checkpoint-open
# integrity verification for lower startup latency. This does not affect frame
# or delta-log checksums.
# export MTXDB_CHECKPOINT_CHECKSUM=writeonly
# scripts/external_bench.py's own opt-out knob, applied only to the mtxdb
# subprocess it spawns (translates to MTXDB_CHECKPOINT_CHECKSUM=writeonly
# above) -- lets a bench run ask for it without setting the engine var
# globally for your own shell.
# export MTXDB_BENCH_CHECKSUM=disabled
