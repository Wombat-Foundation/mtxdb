#!/usr/bin/env bash

# Preserve the parent workspace environment, including its Mold linker flag.
source_up

# Allow submodule-specific environment values.
watch_file .env
if [ -f .env ]; then
	dotenv .env
fi

# Native-CPU codegen is applied by .cargo/cargo-wrapper.sh (set as the
# project's rustc-wrapper in .cargo/config.toml) for every rustc
# invocation, including in CI where this .envrc is never sourced. Do not
# also set it here -- a duplicate RUSTFLAGS export here would just be a
# second source of truth that can drift from the wrapper.
