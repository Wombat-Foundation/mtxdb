#!/usr/bin/env bash

# Preserve the parent workspace environment, including its Mold linker flag.
source_up

# Allow submodule-specific environment values.
watch_file .env
if [ -f .env ]; then
	dotenv .env
fi

# Native-CPU codegen is optional via .cargo/cargo-wrapper.sh. The wrapper
# is currently disabled (rustc-wrapper is commented out in
# .cargo/config.toml), so no RUSTFLAGS is exported here either: if the
# wrapper is re-enabled, a duplicate export here would just be a second
# source of truth that can drift from it.
